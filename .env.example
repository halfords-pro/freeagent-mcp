# FreeAgent OAuth Credentials
FREEAGENT_CLIENT_ID=your_client_id_here
FREEAGENT_CLIENT_SECRET=your_client_secret_here
FREEAGENT_ACCESS_TOKEN=your_access_token_here
FREEAGENT_REFRESH_TOKEN=your_refresh_token_here

# API Endpoint Configuration
# Use production API (default - can be omitted)
FREEAGENT_API_URL=https://api.freeagent.com/v2

# Or use sandbox API for testing (uncomment to use)
#FREEAGENT_API_URL=https://api.sandbox.freeagent.com/v2

# Note: Only set ONE FREEAGENT_API_URL value. If not set, defaults to production.
# Remember: Sandbox requires separate OAuth credentials from production.

# Environment
NODE_ENV=production
